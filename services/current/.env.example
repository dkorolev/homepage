# Use an EnvironmentFile owned by the service user with mode 0600 in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional external OIDC client (Okta or another issuer).
# ENTERPRISE_OIDC_ISSUER=https://your-org.okta.com/oauth2/default
# ENTERPRISE_OIDC_CLIENT_ID=
# ENTERPRISE_OIDC_CLIENT_SECRET=
# Optional initial access token for an administrator running OIDC DCR/conformance.
# Without this variable a private random value is generated at each start.
# CURRENT_REGISTRATION_TOKEN=
# Optional private JSON array of persistent OIDC client registrations (mode 0600).
# CURRENT_CLIENTS_FILE=/secure/path/clients.json
